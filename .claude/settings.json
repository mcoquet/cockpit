{
  "env": {
    "SUPERPOWERS_DISABLE_TELEMETRY": "1"
  },
  "extraKnownMarketplaces": {
    "sw-eng-doc-mastery": {
      "source": {
        "source": "github",
        "repo": "mcoquet/sw_eng_doc_mastery"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@sw-eng-doc-mastery": true,
    "doc-mastery@sw-eng-doc-mastery": true
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push origin claude/*)"
    ]
  }
}
