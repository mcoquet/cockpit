#!/bin/bash
#
# Pre-push hook: Auto-sync package.json + package-lock.json version when pushing a version tag
#
# When you push a tag like v0.7.0, this hook:
# 1. Checks if package.json version matches
# 2. If not, updates package.json and package-lock.json, commits, moves the tag,
#    and aborts the push. Git resolves what to push before this hook runs, so
#    the bump commit would otherwise be left off the branch. Re-running the
#    same push sends the branch and tag together.
#

BUMPED=""

while read local_ref local_sha remote_ref remote_sha; do
  # Check if this is a version tag (refs/tags/v*)
  if [[ "$local_ref" =~ ^refs/tags/v([0-9]+\.[0-9]+\.[0-9]+.*)$ ]]; then
    VERSION="${BASH_REMATCH[1]}"
    TAG_NAME="${local_ref#refs/tags/}"

    # Get current package.json version
    CURRENT_VERSION=$(node -p "require('./package.json').version")

    if [[ "$CURRENT_VERSION" != "$VERSION" ]]; then
      echo "📦 Syncing package.json version: $CURRENT_VERSION → $VERSION"

      # Update package.json, commit, and move the tag to the new commit
      if ! npm version "$VERSION" --no-git-tag-version --allow-same-version \
        || ! git add package.json package-lock.json \
        || ! git commit -m "chore: bump version to $VERSION" \
        || ! git tag -f "$TAG_NAME"; then
        echo "✗ Version bump failed; push aborted." >&2
        exit 1
      fi

      BUMPED="$TAG_NAME"
    fi
  fi
done

if [[ -n "$BUMPED" ]]; then
  echo "✓ Committed the version bump and moved $BUMPED to it." >&2
  echo "  Push aborted so the branch isn't left behind. Run the same git push again." >&2
  exit 1
fi

exit 0
