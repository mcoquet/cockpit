{
  "appId": "com.cockpit.app",
  "productName": "Cockpit",
  "directories": {
    "output": "out"
  },
  "files": [
    "dist/**/*",
    "assets/**/*"
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": ["dmg", "dir"],
    "icon": "assets/icon.icns",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "dmg": {
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  }
}
