{
  "name": "cockpit",
  "version": "0.7.0",
  "description": "Claude Code project manager for macOS",
  "main": "dist/main/main/index.js",
  "scripts": {
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "git config core.hooksPath .githooks && electron-rebuild -f -w node-pty",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\" \"wait-on dist/main/main/index.js http://localhost:5173 && NODE_ENV=development electron .\"",
    "start": "electron .",
    "package": "npm run build && electron-builder"
  },
  "keywords": [
    "electron",
    "claude",
    "menubar"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "electron-store": "^11.0.2",
    "node-pty": "^1.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@types/node": "^25.2.0",
    "electron": "^40.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "concurrently": "^9.2.1",
    "electron-builder": "^26.7.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  }
}
